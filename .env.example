# Copie para .env (que não é versionado) e ajuste os valores.
# Os valores abaixo são fictícios, para uso apenas local.

WB_ENV=dev

# Usados pelo docker-compose.yml para criar o banco
POSTGRES_USER=wb
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=world_bank

# Usado pelo pipeline para conectar ao banco
DATABASE_URL=postgresql://wb:troque_esta_senha@127.0.0.1:5433/world_bank

# Usuário só de leitura dos dashboards (Streamlit e Power BI). O `migrate` define a senha
# dele a partir daqui.
DASHBOARD_DATABASE_URL=postgresql://dashboard_leitor:troque_esta_senha_do_leitor@127.0.0.1:5433/world_bank

# Opcional: tire o # para o `docker compose up` ligar também a ponte do Claude Code.
# COMPOSE_PROFILES=mcp
