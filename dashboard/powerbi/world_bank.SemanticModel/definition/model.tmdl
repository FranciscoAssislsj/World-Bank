model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ServidorBanco", "NomeBanco", "resumo_anual", "pais_ano", "ranking_crescimento", "resumo_renda_regiao", "Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table resumo_anual
ref table pais_ano
ref table ranking_crescimento
ref table resumo_renda_regiao
ref table Medidas

ref cultureInfo pt-BR

