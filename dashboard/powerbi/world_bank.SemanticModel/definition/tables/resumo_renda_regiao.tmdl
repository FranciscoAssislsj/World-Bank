	partition resumo_renda_regiao = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(ServidorBanco, NomeBanco),
				    Consulta = Value.NativeQuery(Fonte, "select ano, nivel_renda, nivel_renda_ordem, mediana from gold.resumo_renda_regiao where recorte = 'renda' and indicador_id = 'SP.DYN.LE00.IN'")
				in
