	partition resumo_anual = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(ServidorBanco, NomeBanco),
				    Consulta = Value.NativeQuery(Fonte, "select ano, paises_com_valor, paises_no_grupo, cobertura_pct, mediana_renda_alta, mediana_renda_baixa, diferenca_renda_anos, maior_pib_pais, maior_pib_bilhoes, brasil_expectativa_vida, brasil_pib_per_capita_usd, brasil_pib_bilhoes, brasil_posicao_pib from gold.resumo_anual")
				in
				    Consulta

	annotation PBI_ResultType = Table

